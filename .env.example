# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real
# values. `.env` is gitignored — never commit real secrets.
#
# docker-compose and Spring Boot both read these via ${VAR} substitution, so this
# one file drives local Docker, and the same names are what you set as env vars
# on Railway/Render for a real deployment.

# --- Database ---
DB_NAME=blncr
DB_USERNAME=postgres
# Required — no default anywhere. Use a long random value, e.g.: openssl rand -base64 24
DB_PASSWORD=
# Use "require" (or "verify-full") for any hosted/remote database. "prefer" is only for local Docker.
DB_SSL_MODE=prefer

# --- JWT ---
# Required — the app fails to start without it (must decode to >= 32 bytes).
# Generate a strong random secret, e.g.: openssl rand -base64 64
JWT_SECRET=
# Token lifetime in milliseconds. 86400000 = 24 hour. Keep this short.
JWT_EXPIRATION_MS=86400000

# --- Error tracking (optional) ---
# Create a Sentry project and configure this in the host's secret store to enable reporting.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- CORS ---
# Add the deployed Vercel URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Abuse protection (optional; defaults shown) ---
# RATE_LIMIT_LOGIN_PER_MINUTE=20
# RATE_LIMIT_REGISTER_PER_MINUTE=10
# MAX_BODY_BYTES=65536

# --- Registration email check (optional) ---
# Set to false to skip the DNS/MX lookup of the email's domain.
# EMAIL_MX_CHECK=true
