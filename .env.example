# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real
# values. `.env` is gitignored — never commit real secrets.
#
# docker-compose and Spring Boot both read these via ${VAR} substitution, so this
# one file drives local Docker, and the same names are what you set as env vars
# on Railway/Render for a real deployment.

# --- Database ---
DB_NAME=blncr
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
# Required — the app fails to start without it. Generate a strong random secret,
# e.g.: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated, no spaces. Add the deployed Vercel URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
