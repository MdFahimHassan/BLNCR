# Copy this file to `.env` (or `.env.local`) in this folder.
# Vite bakes VITE_* values in at BUILD time, so after changing this on a host
# (e.g. Vercel) you must redeploy for it to take effect.

# Base URL of the backend API: no trailing slash.
# Local development (Spring Boot on port 9090):
VITE_API_BASE_URL=http://localhost:9090
# Production example:
# VITE_API_BASE_URL=https://blncr.onrender.com
